{
  "name": "fade",
  "private": true,
  "workspaces": [
    "app",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc -p packages/engine && tsc -p tools/solver",
    "solve": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/solver/src/cli.ts",
    "sync-engine": "node tools/scripts/sync-engine.mjs",
    "online-smoke": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/scripts/online-smoke.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@jest/globals": "^30.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "typescript": "~6.0.3"
  }
}
